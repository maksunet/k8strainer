pipeline {
    agent any

    environment {
        REGISTRY = "192.168.201.129"
        GIT_SSH_COMMAND = "ssh -i /var/lib/jenkins/.ssh/id_ed25519_github -o IdentitiesOnly=yes -o StrictHostKeyChecking=no"
        DOCKER_CONFIG = "${env.WORKSPACE}/.docker"
    }

    stages {
        stage('Guard: skip CI-authored commits') {
            steps {
                script {
                    def author = sh(script: 'git log -1 --pretty=%an', returnStdout: true).trim()
                    env.IS_BOT_COMMIT = (author == 'Jenkins') ? 'true' : 'false'
                    if (env.IS_BOT_COMMIT == 'true') {
                        echo "Last commit was made by our own CI bot -- skipping to avoid an infinite build loop."
                    }
                }
            }
        }

        stage('Build & Push') {
            when { expression { env.IS_BOT_COMMIT != 'true' } }
            steps {
                withCredentials([usernamePassword(credentialsId: 'harbor-creds', usernameVariable: 'HARBOR_USER', passwordVariable: 'HARBOR_PASS')]) {
                    script {
                        // folder name -> harbor image name
                        def services = [
                            'auth-service'   : 'auth-service',
                            'blog-service'   : 'blog-service',
                            'gateway-service': 'blog-gateway-service'
                        ]
                        def tag = "${env.BUILD_NUMBER}-${env.GIT_COMMIT.take(7)}"
                        env.TAG = tag

                        sh 'mkdir -p "$DOCKER_CONFIG"'
                        sh "echo \$HARBOR_PASS | docker login ${REGISTRY} -u \$HARBOR_USER --password-stdin"

                        services.each { folder, image ->
                            dir("blog/${folder}") {
                                sh "docker build -t ${REGISTRY}/demo/${image}:${tag} ."
                                sh "docker push ${REGISTRY}/demo/${image}:${tag}"
                            }
                        }

                        sh "docker logout ${REGISTRY}"
                    }
                }
            }
        }

        stage('Update manifests & push to git') {
            when { expression { env.IS_BOT_COMMIT != 'true' } }
            steps {
                script {
                    sh 'git remote set-url origin git@github.com:maksunet/k8strainer.git'
                    sh 'git config user.email "jenkins@k8strainer.local"'
                    sh 'git config user.name "Jenkins"'

                    sh "sed -i 's#image: .*auth-service:.*#image: ${REGISTRY}/demo/auth-service:${env.TAG}#' blog/k8s/auth.yaml"
                    sh "sed -i 's#image: .*/demo/blog-service:.*#image: ${REGISTRY}/demo/blog-service:${env.TAG}#' blog/k8s/blog-service.yaml"
                    sh "sed -i 's#image: .*blog-gateway-service:.*#image: ${REGISTRY}/demo/blog-gateway-service:${env.TAG}#' blog/k8s/gateway.yaml"

                    sh """
                        git add blog/k8s
                        git commit -m "ci: deploy blog platform ${env.TAG}" || echo "no changes to commit"
                        for i in 1 2 3 4 5; do
                            git push origin HEAD:dev && break
                            echo "push rejected, retrying with rebase (\$i)..."
                            git pull --rebase origin dev
                            sleep \$((RANDOM % 5 + 1))
                        done
                    """
                }
            }
        }
    }

    post {
        always {
            sh "docker image prune -f || true"
        }
    }
}
