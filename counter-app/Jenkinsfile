pipeline {
    agent any

    environment {
        REGISTRY = "192.168.201.129"
        IMAGE = "${REGISTRY}/demo/counter-app"
        TAG = "${env.BUILD_NUMBER}-${env.GIT_COMMIT.take(7)}"
        GIT_SSH_COMMAND = "ssh -i /var/lib/jenkins/.ssh/id_ed25519_github -o IdentitiesOnly=yes -o StrictHostKeyChecking=no"
        DOCKER_CONFIG = "${env.WORKSPACE}/.docker"
    }

    stages {
        stage('Guard: skip CI-authored commits') {
            steps {
                script {
                    def author = sh(script: 'git log -1 --pretty=%an', returnStdout: true).trim()
                    env.IS_BOT_COMMIT = (author == 'Jenkins') ? 'true' : 'false'
                    if (env.IS_BOT_COMMIT == 'true') {
                        echo "Last commit was made by our own CI bot -- skipping to avoid an infinite build loop."
                    }
                }
            }
        }

        stage('Build') {
            when { expression { env.IS_BOT_COMMIT != 'true' } }
            steps {
                dir('counter-app') {
                    sh "docker build -t ${IMAGE}:${TAG} ."
                }
            }
        }

        stage('Push to Harbor') {
            when { expression { env.IS_BOT_COMMIT != 'true' } }
            steps {
                withCredentials([usernamePassword(credentialsId: 'harbor-creds', usernameVariable: 'HARBOR_USER', passwordVariable: 'HARBOR_PASS')]) {
                    sh """
                        mkdir -p "\$DOCKER_CONFIG"
                        echo \$HARBOR_PASS | docker login ${REGISTRY} -u \$HARBOR_USER --password-stdin
                        docker push ${IMAGE}:${TAG}
                        docker logout ${REGISTRY}
                    """
                }
            }
        }

        stage('Update manifest & push to git') {
            when { expression { env.IS_BOT_COMMIT != 'true' } }
            steps {
                sh """
                    git remote set-url origin git@github.com:maksunet/k8strainer.git
                    git config user.email "jenkins@k8strainer.local"
                    git config user.name "Jenkins"
                    sed -i "s#image: .*#image: ${IMAGE}:${TAG}#" counter-app/k8s/deployment.yaml
                    git add counter-app/k8s/deployment.yaml
                    git commit -m "ci: deploy counter-app ${TAG}" || echo "no changes to commit"
                    for i in 1 2 3 4 5; do
                        git push origin HEAD:dev && break
                        echo "push rejected, retrying with rebase (\$i)..."
                        git pull --rebase origin dev
                        sleep \$((RANDOM % 5 + 1))
                    done
                """
            }
        }
    }

    post {
        always {
            sh "docker image prune -f || true"
        }
    }
}
